{
  "main function": {
    "prefix": "main",
    "body": [
      "fn main() {",
      "\t$0",
      "}"
    ],
    "description": "Entry point: runs when the file is the program being run"
  },
  "init function": {
    "prefix": "init",
    "body": [
      "fn init() {",
      "\t$0",
      "}"
    ],
    "description": "Module initializer: runs once when the module is first loaded"
  },
  "function": {
    "prefix": "fn",
    "body": [
      "fn ${1:name}(${2:x}: ${3:int}) -> ${4:int} {",
      "\t${0:$2}",
      "}"
    ],
    "description": "Function declaration"
  },
  "public function": {
    "prefix": "pubfn",
    "body": [
      "pub fn ${1:name}(${2:x}: ${3:int}) -> ${4:int} {",
      "\t${0:$2}",
      "}"
    ],
    "description": "Function exported from its module"
  },
  "generic function": {
    "prefix": "fng",
    "body": [
      "fn ${1:identity}<${2:T}>(${3:x}: $2) -> $2 {",
      "\t${0:$3}",
      "}"
    ],
    "description": "Generic function declaration"
  },
  "lambda": {
    "prefix": "lambda",
    "body": "fn(${1:x}: ${2:int}) -> ${3:int} { ${0:$1} }",
    "description": "Lambda (closure) expression"
  },
  "struct": {
    "prefix": "struct",
    "body": [
      "struct ${1:Name} {",
      "\t${2:field}: ${3:int}",
      "}"
    ],
    "description": "Struct declaration"
  },
  "actor": {
    "prefix": "actor",
    "body": [
      "actor ${1:Counter} {",
      "\t${2:count}: ${3:int}",
      "}",
      "",
      "impl $1 {",
      "\tfn new() -> $1 {",
      "\t\t$1 { $2: ${4:0} }",
      "\t}",
      "$0",
      "}"
    ],
    "description": "Actor with a constructor; start it with `spawn Name.new()`"
  },
  "enum": {
    "prefix": "enum",
    "body": "enum ${1:Name} { ${2:First}, ${3:Second} }",
    "description": "Integer-backed enum declaration"
  },
  "sum type": {
    "prefix": "type",
    "body": "type ${1:Result} = ${2:Ok}(${3:int}) | ${4:Err}(${5:string})",
    "description": "Sum type declaration"
  },
  "interface": {
    "prefix": "interface",
    "body": [
      "interface ${1:Describe} {",
      "\tfn ${2:describe}() -> ${3:string}",
      "}"
    ],
    "description": "Interface declaration"
  },
  "impl block": {
    "prefix": "impl",
    "body": [
      "impl ${1:Type} {",
      "\tfn ${2:method}(self) {",
      "\t\t$0",
      "\t}",
      "}"
    ],
    "description": "Methods for a struct or actor"
  },
  "impl interface": {
    "prefix": "implfor",
    "body": [
      "impl ${1:Interface} for ${2:Type} {",
      "\tfn ${3:describe}(self) -> ${4:string} {",
      "\t\t${0:\"\"}",
      "\t}",
      "}"
    ],
    "description": "Implement an interface for a struct"
  },
  "mutable variable": {
    "prefix": "mut",
    "body": "mut ${1:name} = ${0:0}",
    "description": "Mutable variable"
  },
  "immutable variable": {
    "prefix": "imut",
    "body": "imut ${1:name} = ${0:0}",
    "description": "Immutable variable"
  },
  "if": {
    "prefix": "if",
    "body": [
      "if ${1:condition} {",
      "\t$0",
      "}"
    ],
    "description": "If statement"
  },
  "if else": {
    "prefix": "ifelse",
    "body": [
      "if ${1:condition} {",
      "\t$2",
      "} else {",
      "\t$0",
      "}"
    ],
    "description": "If / else statement"
  },
  "while": {
    "prefix": "while",
    "body": [
      "while ${1:condition} {",
      "\t$0",
      "}"
    ],
    "description": "While loop"
  },
  "do while": {
    "prefix": "dowhile",
    "body": [
      "do {",
      "\t$0",
      "} while ${1:condition}"
    ],
    "description": "Do-while loop: the body runs before the condition is checked"
  },
  "for": {
    "prefix": "for",
    "body": [
      "for mut ${1:i} = 0 $1 < ${2:n} $1 = $1 + 1 {",
      "\t$0",
      "}"
    ],
    "description": "C-style for loop"
  },
  "for in": {
    "prefix": "forin",
    "body": [
      "for ${1:item} in ${2:items} {",
      "\t$0",
      "}"
    ],
    "description": "Iterate an array, a map's keys, a set or a channel"
  },
  "match": {
    "prefix": "match",
    "body": [
      "match ${1:value} {",
      "\t${2:1} => ${3:println(\"one\")},",
      "\t_ => ${0:println(\"other\")},",
      "}"
    ],
    "description": "Match expression"
  },
  "try catch": {
    "prefix": "try",
    "body": [
      "try {",
      "\t${1:throw \"error\"}",
      "} catch ${2:e} {",
      "\t${0:println(toString($2))}",
      "}"
    ],
    "description": "Try / catch"
  },
  "throw": {
    "prefix": "throw",
    "body": "throw ${0:\"message\"}",
    "description": "Raise a value as an error"
  },
  "scope": {
    "prefix": "scope",
    "body": [
      "scope {",
      "\tspawn {",
      "\t\t$1",
      "\t}",
      "\tspawn {",
      "\t\t$0",
      "\t}",
      "}"
    ],
    "description": "Structured concurrency: spawned tasks are joined at the end of the scope"
  },
  "spawn": {
    "prefix": "spawn",
    "body": [
      "spawn {",
      "\t$0",
      "}"
    ],
    "description": "Run a block on its own virtual thread"
  },
  "send": {
    "prefix": "send",
    "body": "send ${1:worker}.${2:method}($3)",
    "description": "Fire-and-forget message to an actor"
  },
  "import": {
    "prefix": "import",
    "body": "import \"${1:std/io}\"",
    "description": "Import a module"
  },
  "import as": {
    "prefix": "importas",
    "body": "import \"${1:std/math}\" as ${2:m}",
    "description": "Import a module under an alias"
  },
  "import java": {
    "prefix": "importjava",
    "body": "import java \"${1:java.util.ArrayList}\"",
    "description": "Import a Java class"
  },
  "test file": {
    "prefix": "test",
    "body": [
      "import \"std/testing\"",
      "",
      "fn ${1:testAddition}() {",
      "\ttesting.assertEqual(toString(${2:1 + 1}), \"${3:2}\", \"${4:adds}\")",
      "}",
      "",
      "fn main() {",
      "\ttesting.run(\"${5:suite}\", [$1])",
      "}"
    ],
    "description": "std/testing suite"
  }
}
