{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Siyo",
  "scopeName": "source.siyo",
  "comment": "TextMate grammar for Siyo 0.9.0 (SiyoCompiler 02c2262: GRAMMAR.md, Lexer.java, Parser.java).",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#import"
    },
    {
      "include": "#function-declaration"
    },
    {
      "include": "#type-declaration"
    },
    {
      "include": "#nominal-declarations"
    },
    {
      "include": "#impl-declaration"
    },
    {
      "include": "#variable-declaration"
    },
    {
      "include": "#send-statement"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#generic-type"
    },
    {
      "include": "#builtin-types"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#set-literal"
    },
    {
      "include": "#member-access"
    },
    {
      "include": "#builtin-functions"
    },
    {
      "include": "#function-call"
    },
    {
      "include": "#wildcard"
    },
    {
      "include": "#type-names"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#identifiers"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comments": {
      "comment": "Only // line comments exist; the lexer has no block comments.",
      "match": "(//).*",
      "name": "comment.line.double-slash.siyo",
      "captures": {
        "1": {
          "name": "punctuation.definition.comment.siyo"
        }
      }
    },
    "strings": {
      "patterns": [
        {
          "include": "#string-triple"
        },
        {
          "include": "#string-double"
        }
      ]
    },
    "string-triple": {
      "comment": "\"\"\" always opens a triple-quoted string, which may span lines.",
      "name": "string.quoted.triple.siyo",
      "begin": "\"\"\"",
      "end": "\"\"\"",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.siyo"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.siyo"
        }
      },
      "patterns": [
        {
          "include": "#string-escapes"
        },
        {
          "include": "#string-interpolation"
        }
      ]
    },
    "string-double": {
      "comment": "A double-quoted string cannot span lines; the lexer ends an unterminated one at the newline.",
      "name": "string.quoted.double.siyo",
      "begin": "\"",
      "end": "\"|$",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.siyo"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.siyo"
        }
      },
      "patterns": [
        {
          "include": "#string-escapes"
        },
        {
          "include": "#string-interpolation"
        }
      ]
    },
    "string-escapes": {
      "patterns": [
        {
          "name": "constant.character.escape.siyo",
          "match": "\\\\[nrt\\\\\"0${}]"
        },
        {
          "name": "invalid.illegal.escape.siyo",
          "match": "\\\\."
        }
      ]
    },
    "string-interpolation": {
      "patterns": [
        {
          "comment": "${expression}",
          "name": "meta.interpolation.siyo",
          "begin": "\\$\\{",
          "end": "\\}",
          "beginCaptures": {
            "0": {
              "name": "punctuation.section.interpolation.begin.siyo"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.section.interpolation.end.siyo"
            }
          },
          "patterns": [
            {
              "include": "#interpolation-braces"
            },
            {
              "include": "$self"
            }
          ]
        },
        {
          "comment": "$name; a $ followed by anything but a letter, _ or { is literal text.",
          "name": "meta.interpolation.siyo",
          "match": "(\\$)([_\\p{L}]\\w*)",
          "captures": {
            "1": {
              "name": "punctuation.definition.interpolation.siyo"
            },
            "2": {
              "name": "variable.other.interpolated.siyo"
            }
          }
        }
      ]
    },
    "interpolation-braces": {
      "comment": "Balanced braces inside ${...} (map literals, blocks) so the inner } does not close the interpolation.",
      "begin": "\\{",
      "end": "\\}",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.braces.begin.siyo"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.braces.end.siyo"
        }
      },
      "patterns": [
        {
          "include": "#interpolation-braces"
        },
        {
          "include": "$self"
        }
      ]
    },
    "import": {
      "patterns": [
        {
          "match": "\\b(import)\\s+(java)\\b",
          "captures": {
            "1": {
              "name": "keyword.control.import.siyo"
            },
            "2": {
              "name": "keyword.other.java.siyo"
            }
          }
        },
        {
          "name": "keyword.control.import.siyo",
          "match": "\\bimport\\b"
        }
      ]
    },
    "function-declaration": {
      "comment": "fn name<T>(...) -- the name may be new, send or type; fn( without a name is a lambda or function type.",
      "begin": "\\b(fn)\\s+([_\\p{L}]\\w*)",
      "end": "(?=[^\\s<])",
      "beginCaptures": {
        "1": {
          "name": "storage.type.function.siyo"
        },
        "2": {
          "name": "entity.name.function.siyo"
        }
      },
      "patterns": [
        {
          "include": "#type-parameter-list"
        }
      ]
    },
    "type-declaration": {
      "comment": "type is a keyword only in `type Name =` or `type Name<T> =`; elsewhere it is an ordinary name.",
      "begin": "\\b(type)\\s+([_\\p{L}]\\w*)(?=\\s*(?:<[\\w\\s,]*>)?\\s*=(?![=>]))",
      "end": "(?==)",
      "beginCaptures": {
        "1": {
          "name": "storage.type.sum.siyo"
        },
        "2": {
          "name": "entity.name.type.sum.siyo"
        }
      },
      "patterns": [
        {
          "include": "#type-parameter-list"
        }
      ]
    },
    "type-parameter-list": {
      "begin": "<",
      "end": ">",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.typeparameters.begin.siyo"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.typeparameters.end.siyo"
        }
      },
      "patterns": [
        {
          "name": "entity.name.type.parameter.siyo",
          "match": "[_\\p{L}]\\w*"
        },
        {
          "include": "#punctuation"
        }
      ]
    },
    "nominal-declarations": {
      "patterns": [
        {
          "comment": "actor Name, or the 0.3-era actor struct Name",
          "match": "\\b(actor)(?:\\s+(struct))?\\s+([_\\p{L}]\\w*)",
          "captures": {
            "1": {
              "name": "storage.type.actor.siyo"
            },
            "2": {
              "name": "storage.type.struct.siyo"
            },
            "3": {
              "name": "entity.name.type.actor.siyo"
            }
          }
        },
        {
          "match": "\\b(struct)\\s+([_\\p{L}]\\w*)",
          "captures": {
            "1": {
              "name": "storage.type.struct.siyo"
            },
            "2": {
              "name": "entity.name.type.struct.siyo"
            }
          }
        },
        {
          "match": "\\b(enum)\\s+([_\\p{L}]\\w*)",
          "captures": {
            "1": {
              "name": "storage.type.enum.siyo"
            },
            "2": {
              "name": "entity.name.type.enum.siyo"
            }
          }
        },
        {
          "match": "\\b(interface)\\s+([_\\p{L}]\\w*)",
          "captures": {
            "1": {
              "name": "storage.type.interface.siyo"
            },
            "2": {
              "name": "entity.name.type.interface.siyo"
            }
          }
        }
      ]
    },
    "impl-declaration": {
      "comment": "impl Struct, or impl Interface for Struct",
      "match": "\\b(impl)\\s+([_\\p{L}]\\w*)(?:\\s+(for)\\s+([_\\p{L}]\\w*))?",
      "captures": {
        "1": {
          "name": "storage.type.impl.siyo"
        },
        "2": {
          "name": "entity.name.type.siyo"
        },
        "3": {
          "name": "keyword.other.for.siyo"
        },
        "4": {
          "name": "entity.name.type.siyo"
        }
      }
    },
    "variable-declaration": {
      "comment": "mut/imut name, also a mut parameter and the C-style for initializer",
      "match": "\\b(mut|imut)\\s+([_\\p{L}]\\w*)",
      "captures": {
        "1": {
          "name": "storage.modifier.siyo"
        },
        "2": {
          "name": "variable.other.definition.siyo"
        }
      }
    },
    "send-statement": {
      "comment": "send is a keyword only as a statement prefix (send actor.method()); elsewhere it is a name.",
      "match": "(?<![\\w.$])(send)(?=\\s+[_\\p{L}(])",
      "captures": {
        "1": {
          "name": "keyword.control.concurrency.siyo"
        }
      }
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.conditional.siyo",
          "match": "\\b(if|else|match)\\b"
        },
        {
          "name": "keyword.control.loop.siyo",
          "match": "\\b(while|for|do|in)\\b"
        },
        {
          "name": "keyword.control.flow.siyo",
          "match": "\\b(return|break|continue|throw)\\b"
        },
        {
          "name": "keyword.control.trycatch.siyo",
          "match": "\\b(try|catch)\\b"
        },
        {
          "name": "keyword.control.concurrency.siyo",
          "match": "\\b(scope|spawn)\\b"
        },
        {
          "name": "keyword.operator.as.siyo",
          "match": "\\bas\\b"
        },
        {
          "name": "storage.modifier.siyo",
          "match": "\\b(mut|imut|pub)\\b"
        },
        {
          "name": "storage.type.function.siyo",
          "match": "\\bfn\\b"
        },
        {
          "name": "storage.type.struct.siyo",
          "match": "\\bstruct\\b"
        },
        {
          "name": "storage.type.actor.siyo",
          "match": "\\bactor\\b"
        },
        {
          "name": "storage.type.enum.siyo",
          "match": "\\benum\\b"
        },
        {
          "name": "storage.type.interface.siyo",
          "match": "\\binterface\\b"
        },
        {
          "name": "storage.type.impl.siyo",
          "match": "\\bimpl\\b"
        },
        {
          "name": "variable.language.self.siyo",
          "match": "\\bself\\b"
        },
        {
          "name": "constant.language.boolean.siyo",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.null.siyo",
          "match": "\\bnull\\b"
        }
      ]
    },
    "generic-type": {
      "comment": "Name<...>: like the parser, only names, commas, brackets, fn types and angle brackets may sit between < and a > on the same line.",
      "patterns": [
        {
          "name": "meta.type.parameters.siyo",
          "begin": "\\b(Array|List|Map|Set)\\s*(<)(?=[\\w\\s,<>\\[\\]()\\-]*>)",
          "end": ">",
          "beginCaptures": {
            "1": {
              "name": "support.type.generic.siyo"
            },
            "2": {
              "name": "punctuation.definition.typeparameters.begin.siyo"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.typeparameters.end.siyo"
            }
          },
          "patterns": [
            {
              "include": "#generic-type-body"
            }
          ]
        },
        {
          "name": "meta.type.parameters.siyo",
          "begin": "\\b([A-Z]\\w*)\\s*(<)(?=[\\w\\s,<>\\[\\]()\\-]*>)",
          "end": ">",
          "beginCaptures": {
            "1": {
              "name": "entity.name.type.siyo"
            },
            "2": {
              "name": "punctuation.definition.typeparameters.begin.siyo"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.typeparameters.end.siyo"
            }
          },
          "patterns": [
            {
              "include": "#generic-type-body"
            }
          ]
        }
      ]
    },
    "generic-type-body": {
      "patterns": [
        {
          "include": "#generic-type"
        },
        {
          "name": "storage.type.function.siyo",
          "match": "\\bfn\\b"
        },
        {
          "name": "support.type.primitive.siyo",
          "match": "\\b(int|long|float|bool|string)\\b"
        },
        {
          "name": "support.type.builtin.siyo",
          "match": "\\b(object|any|channel|map|set)\\b"
        },
        {
          "include": "#type-names"
        },
        {
          "name": "keyword.operator.arrow.siyo",
          "match": "->"
        },
        {
          "include": "#punctuation"
        }
      ]
    },
    "builtin-types": {
      "patterns": [
        {
          "name": "support.type.primitive.siyo",
          "match": "\\b(int|long|float|bool|string)\\b"
        },
        {
          "comment": "object, any, channel, map and set are ordinary names except in a type position: after :, -> or as, or before [].",
          "match": "(?:(?<=:)|(?<=->)|(?<=\\bas))\\s*\\b(object|any|channel|map|set)\\b(?!\\s*\\()",
          "captures": {
            "1": {
              "name": "support.type.builtin.siyo"
            }
          }
        },
        {
          "name": "support.type.builtin.siyo",
          "match": "\\b(object|any|channel|map|set)(?=\\[\\])"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "match": "\\b(0[xX][0-9a-fA-F]+)([lL])?\\b",
          "captures": {
            "1": {
              "name": "constant.numeric.hex.siyo"
            },
            "2": {
              "name": "storage.type.numeric.long.siyo"
            }
          }
        },
        {
          "name": "constant.numeric.float.siyo",
          "match": "\\b[0-9]+\\.[0-9]+\\b"
        },
        {
          "match": "\\b([0-9]+)([lL])?\\b",
          "captures": {
            "1": {
              "name": "constant.numeric.decimal.siyo"
            },
            "2": {
              "name": "storage.type.numeric.long.siyo"
            }
          }
        }
      ]
    },
    "set-literal": {
      "comment": "#{1, 2, 3}",
      "name": "punctuation.definition.set.siyo",
      "match": "#(?=\\{)"
    },
    "member-access": {
      "patterns": [
        {
          "match": "(\\.)\\s*([_\\p{L}]\\w*)(?=\\s*\\()",
          "captures": {
            "1": {
              "name": "punctuation.accessor.dot.siyo"
            },
            "2": {
              "name": "entity.name.function.member.siyo"
            }
          }
        },
        {
          "match": "(\\.)\\s*([_\\p{L}]\\w*)",
          "captures": {
            "1": {
              "name": "punctuation.accessor.dot.siyo"
            },
            "2": {
              "name": "variable.other.property.siyo"
            }
          }
        }
      ]
    },
    "builtin-functions": {
      "comment": "Built-ins documented in GRAMMAR.md 0.9.0 and declared in BuiltinFunctions.java.",
      "name": "support.function.builtin.siyo",
      "match": "\\b(print|println|input|error|len|toString|toInt|toDouble|toFloat|toLong|parseInt|parseFloat|parseLong|substring|contains|indexOf|startsWith|endsWith|replace|trim|toUpper|toLower|split|chr|ord|push|pop|removeAt|sort|map|filter|reduce|forEach|set|channel|range|fields|field|setField|toMap|typeName|typeOf|random|httpGet|httpPost|canRead)\\b(?=\\s*\\()"
    },
    "function-call": {
      "comment": "A PascalCase name before ( is a variant or Java type, handled by type-names.",
      "match": "\\b((?![A-Z])[_\\p{L}]\\w*)(?=\\s*\\()",
      "captures": {
        "1": {
          "name": "entity.name.function.call.siyo"
        }
      }
    },
    "wildcard": {
      "name": "variable.language.wildcard.siyo",
      "match": "\\b_\\b"
    },
    "type-names": {
      "comment": "PascalCase names: structs, actors, enums, sum types and variants, interfaces, imported Java classes.",
      "name": "entity.name.type.siyo",
      "match": "\\b[A-Z]\\w*\\b"
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.siyo",
          "match": "->"
        },
        {
          "name": "keyword.operator.arrow.match.siyo",
          "match": "=>"
        },
        {
          "name": "keyword.operator.assignment.compound.siyo",
          "match": "\\+=|-=|\\*=|/="
        },
        {
          "name": "keyword.operator.bitwise.shift.siyo",
          "match": "<<|>>"
        },
        {
          "name": "keyword.operator.comparison.siyo",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.logical.siyo",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.bitwise.siyo",
          "match": "&|\\||\\^|~"
        },
        {
          "name": "keyword.operator.assignment.siyo",
          "match": "="
        },
        {
          "name": "keyword.operator.arithmetic.siyo",
          "match": "\\+|-|\\*|/|%"
        }
      ]
    },
    "identifiers": {
      "name": "variable.other.siyo",
      "match": "\\b[_\\p{L}]\\w*\\b"
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.comma.siyo",
          "match": ","
        },
        {
          "name": "punctuation.separator.colon.siyo",
          "match": ":"
        },
        {
          "name": "punctuation.accessor.dot.siyo",
          "match": "\\."
        },
        {
          "name": "punctuation.section.braces.begin.siyo",
          "match": "\\{"
        },
        {
          "name": "punctuation.section.braces.end.siyo",
          "match": "\\}"
        },
        {
          "name": "punctuation.section.brackets.begin.siyo",
          "match": "\\["
        },
        {
          "name": "punctuation.section.brackets.end.siyo",
          "match": "\\]"
        },
        {
          "name": "punctuation.section.parens.begin.siyo",
          "match": "\\("
        },
        {
          "name": "punctuation.section.parens.end.siyo",
          "match": "\\)"
        }
      ]
    }
  }
}
